tion convertToInteractive(key) {\n","        const element = document.querySelector('#df-9c3829e9-7c7b-4a05-a62c-56ea73a80da4');\n","        const dataTable =\n","          await google.colab.kernel.invokeFunction('convertToInteractive',\n","                                                    [key], {});\n","        if (!dataTable) return;\n","\n","        const docLinkHtml = 'Like what you see? Visit the ' +\n","          '<a target=\"_blank\" href=https://colab.research.google.com/notebooks/data_table.ipynb>data table notebook</a>'\n","          + ' to learn more about interactive tables.';\n","        element.innerHTML = '';\n","        dataTable['output_type'] = 'display_data';\n","        await google.colab.output.renderOutput(dataTable, element);\n","        const docLink = document.createElement('div');\n","        docLink.innerHTML = docLinkHtml;\n","        element.appendChild(docLink);\n","      }\n","    </script>\n","  </div>\n","\n","\n","    </div>\n","  </div>\n"],"application/vnd.google.colaboratory.intrinsic+json":{"type":"dataframe"}},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","\n","\n","\n","                                         count of missing data in each column\n","                                          \n","Order               0\n","PID                 0\n","MS SubClass         0\n","MS Zoning           0\n","Lot Frontage      490\n","                 ... \n","Mo Sold             0\n","Yr Sold             0\n","Sale Type           0\n","Sale Condition      0\n","SalePrice           0\n","Length: 82, dtype: int64\n"]}]},{"cell_type":"markdown","source":["# Histogram\n","دراینجا نمودار هیستوگرام برای داده های اولیه را رسم کردم سپس مدل لوگاریتمی ان را رسم کردم که داده ها بیشتر در وسط متمرکز بودند به خاطر همین چولگی نمودار کمتر بود و در نتیحه تقریبا نمودار نرمال بود.\n","> **همچنین تابع چگالی احتمال توزیع نرمال از رابطه زیر بدست میاید :**\n","\n","\n","\n","\n","\n","# ***$$f(x) = \\frac{1}{\\sigma \\sqrt{2\\pi}} e^{-\\frac{1}{2}\\left(\\frac{x - \\mu}{\\sigma}\\right)^2}$$***"],"metadata":{"id":"tK1Eluxje1TZ"}},{"cell_type":"code","source":["fig, axes = plt.subplots(1, 2, figsize=(16, 6))\n","\n","sns.histplot(df['SalePrice'], color='blue', ax=axes[0], bins=40)\n","axes[0].set_title('SalePrice', fontsize=14)\n","axes[0].set_xlabel('Selling price', fontsize=12)\n","axes[0].set_ylabel('Quantity', fontsize=12)\n","\n","sns.histplot(np.log1p(df['SalePrice']), color='green', ax=axes[1], bins=40)\n","axes[1].set_title('log of SalePrice', fontsize=14)\n","axes[1].set_xlabel('Log(SalePrice + 1)', fontsize=12)\n","axes[1].set_ylabel('Quantity', fontsize=12)\n","\n","plt.tight_layout()\n","plt.show()\n","initial_skewness = df['SalePrice'].skew()\n","log_skewness = np.log1p(df['SalePrice']).skew()\n","print(f\"Skewness of the initial histogram : {initial_skewness:.2f}\")\n","print(f\"Skewness of the logarithmic histogram : {log_skewness:.2f}\")\n","if (initial_skewness < 0.5 and initial_skewness > -0.5) :\n","  print(\"The initial histogram is normal.\")\n","else :\n","  print(\"The initial histogram is unnormal.\")\n","if (log_skewness < 0.5 and log_skewness > -0.5) :\n","  print(\"The logarithmic histogram is normal.\")\n","else :\n","  print(\"The logarithmic histogram is unnormal.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":508},"id":"bpYRRsnAzy7O","executionInfo":{"status":"ok","timestamp":1788731087361,"user_tz":-210,"elapsed":819,"user":{"displayName":"Alireza","userId":"09331312266932009364"}},"outputId":"cad85e3c-ec0c-4f3b-fe25-9adba988ec72"},"execution_count":66,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1600x600 with 2 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Skewness of the initial histogram : 1.74\n","Skewness of the logarithmic histogram : -0.01\n","The initial histogram is unnormal.\n","The logarithmic histogram is normal.\n"]}]},{"cell_type":"markdown","source":["# Missing data management\n"],"metadata":{"id":"90iYIijeohkZ"}},{"cell_type":"code","source":["numerical = df.select_dtypes(include=[np.number]).columns.tolist()\n","categorical = df.select_dtypes(include=['object', 'category']).columns.tolist()\n","\n","for i in numerical:\n","    if df[i].isnull().sum() == df.shape[0]:\n","        df[i].fillna(0, inplace=True)\n","    elif df[i].isnull().sum() > 0:\n","        mean = df[i].median()\n","        df[i].fillna(mean, inplace=True)\n","\n","for i in categorical:\n","    if df[i].isnull().sum() == df.shape[0]:\n","        df[i].fillna(\"None\", inplace=True)\n","    elif df[i].isnull().sum() > 0:\n","        mod = df[i].mode()[0]\n","        df[i].fillna(mod, inplace=True)\n","print(df)"],"metadata":{"id":"c8MGrAbPVG0F","executionInfo":{"status":"ok","timestamp":1788728213035,"user_tz":-210,"elapsed":61,"user":{"displayName":"Alireza","userId":"09331312266932009364"}},"colab":{"base_uri":"https://localhost:8080/"},"collapsed":true,"outputId":"c3f8b456-3bf3-49c7-8d51-4f0c058dc261"},"execution_count":47,"outputs":[{"output_type":"stream","name":"stdout","text":["      Order        PID  MS SubClass MS Zoning  Lot Frontage  Lot Area Street  \\\n","0         1  526301100           20        RL         141.0     31770   Pave   \n","1         2  526350040           20        RH          80.0     11622   Pave   \n","2         3  526351010           20        RL          81.0     14267   Pave   \n","3         4  526353030           20        RL          93.0     11160   Pave   \n","4         5  527105010           60        RL          74.0     13830   Pave   \n","...     ...        ...          ...       ...           ...       ...    ...   \n","2925   2926  923275080           80        RL          37.0      7937   Pave   \n","2926   2927  923276100           20        RL          68.0      8885   Pave   \n","2927   2928  923400125           85        RL          62.0     10441   Pave   \n","2928   2929  924100070           2